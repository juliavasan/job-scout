# Copy to .env (gitignored) for local runs. In GitHub Actions these are repository secrets.
# See "What it needs from you" in the README for where to get each one.

# Claude: Job Scout uses your logged-in Claude Code (subscription) automatically. No key needed.
# Only if you deliberately want pay-as-you-go API billing instead, set JOBSCOUT_LLM_BACKEND=api and:
# ANTHROPIC_API_KEY=

# SerpApi (Google Jobs search), free plan = 250 searches/month
SERPAPI_API_KEY=

# Google service account key file (download from Google Cloud; keep it in secrets/, which is gitignored)
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json
# In CI the file's full contents go in the GOOGLE_SERVICE_ACCOUNT_JSON secret instead.

# ID of your "Job Scout" Drive folder (from its URL: drive.google.com/drive/folders/<ID>)
JOBSCOUT_ROOT_FOLDER_ID=

# Optional knobs (defaults shown)
# JOBSCOUT_LLM_BACKEND=auto          # auto | claude-code | api
# JOBSCOUT_MAX_QUERIES=4             # SerpApi searches per person per run
# JOBSCOUT_MAX_NEW_ROWS=25
# JOBSCOUT_MIN_FIT_SCORE=6
# JOBSCOUT_MAX_AGE_DAYS=7
# JOBSCOUT_PER_COMPANY=5             # new postings per watched company per run
# JOBSCOUT_WATCH_MAX_AGE_DAYS=90
# JOBSCOUT_MAX_LOOKUPS=0             # extra SerpApi lookups per job (LinkedIn/company links)
# JOBSCOUT_SERP_CACHE_HOURS=20       # local cache of SerpApi results
