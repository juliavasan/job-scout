# Copy to .env (gitignored) for local runs. In GitHub Actions these are repository secrets.
ANTHROPIC_API_KEY=
SERPAPI_API_KEY=
# Either a path to the service-account key file...
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json
# ...or the full JSON contents (this is what CI uses):
# GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional: the profiles mapping as YAML text instead of profiles.yaml
# PROFILES_YAML=
