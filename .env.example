# Copy to .env (gitignored) for local runs. In GitHub Actions these are repository secrets.
ANTHROPIC_API_KEY=
SERPAPI_API_KEY=

# Google service account key file (download from Google Cloud; keep it in secrets/, which is gitignored)
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json
# In CI the file's full contents go in the GOOGLE_SERVICE_ACCOUNT_JSON secret instead.

# ID of your "Job Scout" Drive folder (from its URL: drive.google.com/drive/folders/<ID>)
JOBSCOUT_ROOT_FOLDER_ID=

# Optional knobs (defaults shown)
# JOBSCOUT_MAX_NEW_ROWS=25
# JOBSCOUT_MAX_AGE_DAYS=7
# JOBSCOUT_MIN_FIT_SCORE=6
# JOBSCOUT_MAX_QUERIES=4
# JOBSCOUT_PAGES_PER_QUERY=1
